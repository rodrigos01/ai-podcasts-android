<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- AppCompat-based (still light, no action bar) only because the Cast route dialog is an
         AppCompat dialog fragment that reads its colors from the activity theme; with a plain
         framework theme it crashes when the cast button is tapped. The UI itself is Compose. -->
    <style name="Theme.AIPodcasts" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>
